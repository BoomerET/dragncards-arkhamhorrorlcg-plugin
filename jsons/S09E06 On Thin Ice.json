            ["CALCULATOR_PROMPT", "$GAME.firstPlayer", "Enter time passed", 1, 30, 0, "ON_THIN_ICE_TIME_CALLBACK", "$GAME.firstPlayer", "", ""]
        ],
        "On Thin Ice Scenario Init Continue 1": [
            ["VAR", "$DOOM", ["TO_INT", ["DIVIDE", "$GAME.arkham.scenarioOnThinIceTimePassed", 5]]],
            ["COND",
                ["GREATER_THAN", "$DOOM", 0],
                ["DO_PLACE_DOOM_ON_CURRENT_AGENDA_SCN", "$DOOM"]
            ],
            ["SET", "/arkham/finalScenarioMessage", "Outer Wilderness cards are in Deck A. Off Map is “the shadows” (in play)."],
            ["SCENARIO_INIT_CONTINUE", null]
        ]
    },
    "functions": {
        "ON_THIN_ICE_TIME_CALLBACK": {
            "args": ["$TARGET_PLAYER", "$TARGET_CARD_ID", "$ARGS", "$ACTOR_PLAYER", "$SELECTED_VALUE"],
            "code": [
                ["VALIDATE_PLAYER", "$TARGET_PLAYER", "ON_THIN_ICE_TIME_CALLBACK.TARGET_PLAYER"],
                ["VALIDATE_NOT_NULL", "$ARGS", "ON_THIN_ICE_TIME_CALLBACK.ARGS"],
                ["VALIDATE_NOT_EMPTY", "$SELECTED_VALUE", "ON_THIN_ICE_TIME_CALLBACK.SELECTED_VALUE"],
                ["VAR", "$VALUE", ["CALC", "{{$SELECTED_VALUE}}"]],
                ["VALIDATE_GT0", "$VALUE", "ON_THIN_ICE_TIME_CALLBACK.SELECTED_VALUE"],
                ["SET", "/arkham/scenarioOnThinIceTimePassed", "$VALUE"],
                ["LOGF", "{0}{1} set time passed to {2}.", "$ARGS", "$TARGET_PLAYER", "$VALUE"],
                ["ACTION_LIST", "On Thin Ice Scenario Init Continue 1"]
            ]
        }
    }
}
