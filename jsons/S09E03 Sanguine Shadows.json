        ],
        "Sanguine Shadows Scenario Early Init Continue 1": [
            ["LOG", "└── Decision: {{$GAME.arkham.scenarioAnswer1Text}}"],
            ["COND",
                ["EQUAL", "$GAME.arkham.scenarioAnswer1", "A"],
                [
                    ["LOG", "└── Campaign Log: Remember that “Matias Bolívar trusts you.”"],
                    ["SCARLET_KEYS_REMOVE_ADD_CHAOS_TOKENS", "chaos_elder_thing", "chaos_tablet"]
                ],
                ["EQUAL", "$GAME.arkham.scenarioAnswer1", "C"],
                [
                    ["LOG", "└── Campaign Log: Remember that “Matias Bolívar doesn’t trust you.”"],
                    ["SCARLET_KEYS_REMOVE_ADD_CHAOS_TOKENS", "chaos_tablet", "chaos_elder_thing"]
                ]
            ],
            ["SCENARIO_INIT_RESUME", "Sanguine Shadows Scenario Init"]
        ],
