            ["DO_LOAD_CARDS_SCN", "Sanguine Shadows"],
            ["DO_LOAD_CARDS_SCN", "Dark Veiling"],
            ["DO_LOAD_CARDS_SCN", "Mysteries Abound"],
            ["DO_LOAD_CARDS_SCN", "Shadow of a Doubt"],
            ["DO_LOAD_CARDS_SCN", "Strange Happenings"],
            ["DO_LOAD_CARDS_SCN", "Locked Doors"],
            ["DO_LOAD_CARDS_SCN", "Nightgaunts"],
            ["DO_SPAWN_MINI_INVESTIGATORS_AT_LOCATION", "Avenida de Mayo", 5, 7, 3, 0],
            ["VAR", "$LOCATIONS", ["SHUFFLE_LIST", ["LIST", "09550", "09551", "09552", "09553", "09554", "09555", "09556"]]], //Casa Rosada, Catedral Metropolitana, Cementario de la Recoleta, Palacio Errázuriz, The Cabildo, Banco de la Provincia, Teatro Colón
            ["DO_SPAWN_LOCATIONS_SCN", null, "$LOCATIONS", ["LIST", 32, 58, 70, 58, 32, 20], ["LIST", 10, 10, 43, 76, 76, 43], 0, 6, 0],
            ["FOR_EACH_START_STOP_STEP", "$I", 0, 6, 1, [
                ["DO_PLACE_RESOURCES_ON_CARD", "$GAME.firstPlayer", ["GET_NAMED_CARD_ID", "$LOCATIONS.[$I]"], 1, true, null]
            ]],
            ["VAR", "$CHICA", ["GET_NAMED_CARD_ID", "09557"]], //La Chica Roja: The Girl in the Carmine Coat
            ["SCARLET_KEYS_CONCEAL", "$GAME.firstPlayer", "$CHICA", true, null],
            ["VAR", "$CONCEALED", ["CARDS_TO_CARD_IDS", ["FILTER_CARDS", "$CARD", ["AND",
                ["EQUAL", "$CARD.groupId", "sharedLocations"],
                ["EQUAL", "$CARD.sides.A.type", "MiniConcealed"]
            ]]]],
            ["FOR_EACH_START_STOP_STEP", "$I", 0, 6, 1, [
                ["DO_SPAWN_NAMED_AT_LOCATION_SCN", "$CONCEALED.[$I]", "$LOCATIONS.[$I]", 5, 7, 1]
            ]],
            ["VAR", "$FINAL_MESSAGE", "Off Map is “the shadows” (in play)."],
            ["COND",
                ["EQUAL", "$GAME.arkham.scarletKeysExtraExp", 1],
                ["UPDATE_VAR", "$FINAL_MESSAGE", "{{$FINAL_MESSAGE}} Each investigator earns 1 experience."]
            ],
            ["SET", "/arkham/finalScenarioMessage", "{{$FINAL_MESSAGE}}"],
            ["SCENARIO_INIT_CONTINUE", null]
        ]
    }
