                ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysBaseVariant", 2],
                [
                    //Find each Coterie enemy from the Red Coterie encounter set who voted “yea,” along with The Red-Gloved Man, and set each of those enemies aside, out of play.
