                    ["FOR_EACH_VAL", "$DATABASE_ID", "$YEAS", [
                        ["DO_CREATE_CARDS_SCN", ["GET_DATABASE_NAME", null, "$DATABASE_ID", false], "$DATABASE_ID", 1, "sharedNotInPlay"]
                    ]],
                    //For each member of the Coterie who voted “nay,” find their Conspirator story asset version and put them into play under any investigator’s control.
                    ["CONGRESS_OF_THE_KEYS_SPAWN_CONSPIRATORS", ["CONGRESS_OF_THE_KEYS_LIST_VOTING_CONSPIRATORS", 2, false]],
                    ["UPDATE_VAR", "$FINAL_MESSAGE", "{{$FINAL_MESSAGE}} Put the Conspirator story assets in play under any investigator’s control."]
                ],
                ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysBaseVariant", 3],
                [
                    //Find each Coterie enemy from the Red Coterie encounter set who was eerily silent.
                    ["VAR", "$SILENTS", ["SHUFFLE_LIST", ["CONGRESS_OF_THE_KEYS_LIST_VOTING_ENEMIES", 4, false]]],
                    //The lead investigator spawns The Red-Gloved Man in the shadows and resolves its concealed keyword (as granted by act 1a).
                    ["CONGRESS_OF_THE_KEYS_SPAWN_RED_GLOVED_MAN"],
                    ["UPDATE_VAR", "$FINAL_MESSAGE", "{{$FINAL_MESSAGE}} The lead investigator must finish placing The Red-Gloved Man’s concealed mini-cards."],
                    //Shuffle the rest of the gathered Coterie enemies. One at a time, in player order, each investigator other than the lead investigator draws 1 of them, spawning them as normal.
                    ["FOR_EACH_VAL", "$PLAYER_I", "$PLAYER_ORDER", [
                        ["COND",
                            ["NOT_EQUAL", "$PLAYER_I", "$GAME.firstPlayer"],
                            [
                                ["VAR", "$NAME", ["GET_DATABASE_NAME", null, "$SILENTS.[0]", false]],
                                ["DO_CREATE_CARDS_SCN", "$NAME", "$SILENTS.[0]", 1, "sharedNotInPlay"],
                                ["DO_MOVE_NAMED_DECK_CARDS_SCN", "$NAME", "sharedNotInPlay", 1, ["GET_CONTROLLER_HAND", "$PLAYER_I"]],
                                ["UPDATE_VAR", "$SILENTS", ["LIST_DELETE_AT", "$SILENTS", 0]]
                            ]
                        ]
                    ]],
                    ["COND",
                        ["GREATER_THAN", "$GAME.arkham.numPlayers", 1],
                        ["UPDATE_VAR", "$FINAL_MESSAGE", "{{$FINAL_MESSAGE}} In player order, each investigator (other than lead investigator) must finish spawning the Coterie enemy in their Hand."]
                    ],
                    //Shuffle the rest of the gathered Coterie enemies (those not drawn in the previous step) into the encounter deck.
                    ["FOR_EACH_VAL", "$DATABASE_ID", "$SILENTS", [
                        ["DO_CREATE_CARDS_SCN", ["GET_DATABASE_NAME", null, "$DATABASE_ID", false], "$DATABASE_ID", 1, "sharedEncounterDeck"]
                    ]],
                    //Check the Campaign Log. If the Red Coterie spared the cell, find the Conspirator story asset version of The Red-Gloved Man, along with each other member of the Coterie who was not gathered during the above step. Put each of them into play under any investigator’s control.
                    ["COND",
                        ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVariant", 36],
                        [
                            ["CONGRESS_OF_THE_KEYS_SPAWN_CONSPIRATORS", ["CONGRESS_OF_THE_KEYS_LIST_VOTING_CONSPIRATORS", -4, true]],
                            ["UPDATE_VAR", "$FINAL_MESSAGE", "{{$FINAL_MESSAGE}} Put the Conspirator story assets in play under any investigator’s control. For the remainder of this scenario, ignore the unique symbol on both versions of The Red-Gloved Man."]
                        ]
                    ]
                ]
            ],
            ["COND",
                ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysBaseVariant", 1],
                [
                    ["DO_LOAD_CARDS_INTO_SCN", "Agents of the Outside", "sharedDeckA"],
                    ["DO_LOAD_CARDS_INTO_SCN", "Beyond the Beyond", "sharedDeckA"],
                    ["DO_LOAD_CARDS_INTO_SCN", "Outsiders", "sharedDeckA"],
                    ["DO_LOAD_CARDS_INTO_SCN", "Secret War", "sharedDeckA"],
                    ["DO_LOAD_CARDS_INTO_SCN", "Ancient Evils", "sharedDeckA"],
                    ["DO_LOAD_CARDS_INTO_SCN", "Striking Fear - No Rotting Remains", "sharedDeckA"],
                    ["CONGRESS_OF_THE_KEYS_OTHERWORLD", "sharedDeckB"],
                    ["UPDATE_VAR", "$FINAL_MESSAGE", "Deck A is the second encounter deck, Deck B is the Otherworld deck. {{$FINAL_MESSAGE}}"]
                ],
                ["TRUE"],
                ["UPDATE_VAR", "$FINAL_MESSAGE", "Deck A is the Otherworld deck. {{$FINAL_MESSAGE}}"]
            ],
            ["SET", "/arkham/finalScenarioMessage", "{{$FINAL_MESSAGE}}"],
            ["SCENARIO_INIT_CONTINUE", null]
        ]
    },
    "functions": {
        "CONGRESS_OF_THE_KEYS_TRIAL": {
            "args": ["$QUESTION"],
            "code": [
                ["VALIDATE_GT0", "$QUESTION", "CONGRESS_OF_THE_KEYS_TRIAL.QUESTION"],
                ["VAR", "$TEXT", "$GAME.arkham.scenarioAnswer{{$QUESTION}}Text"],
                ["COND",
                    ["AND",
                        ["NOT_EQUAL", "$TEXT", "None of the above are true."],
                        ["NOT_EQUAL", "$TEXT", "Neither of the above are true."],
                        ["NOT_EQUAL", "$TEXT", "The above is not true."]
                    ],
                    ["LOG", "└── The Trial: {{$TEXT}}"]
                ]
            ]
        },
        "CONGRESS_OF_THE_KEYS_VOTE_RESULT": {
            "args": ["$NAME", "$VAR", "$VALUE"],
            "code": [
                ["VALIDATE_NOT_EMPTY", "$NAME", "CONGRESS_OF_THE_KEYS_VOTE_RESULT.NAME"],
                ["VALIDATE_NOT_EMPTY", "$VAR", "CONGRESS_OF_THE_KEYS_VOTE_RESULT.VAR"],
                ["VALIDATE_GE0", "$VALUE", "CONGRESS_OF_THE_KEYS_VOTE_RESULT.VALUE"],
                ["COND",
                    ["EQUAL", "$VALUE", 10],
                    ["LOG", "└── {{$NAME}} votes “yea.”"],
                    ["EQUAL", "$VALUE", 11],
                    ["LOG", "└── {{$NAME}} enthusiastically votes “yea.”"],
                    ["EQUAL", "$VALUE", 12],
                    ["LOG", "└── {{$GAME.firstPlayer}} votes “yea” in {{$NAME}}’s stead."],
                    ["EQUAL", "$VALUE", 20],
                    ["LOG", "└── {{$NAME}} votes “nay.”"],
                    ["EQUAL", "$VALUE", 30],
                    ["LOG", "└── {{$NAME}} abstains."],
                    ["EQUAL", "$VALUE", 31],
                    ["LOG", "└── {{$NAME}} abstains by default."],
                    ["EQUAL", "$VALUE", 40],
                    ["LOG", "└── {{$NAME}} remains eerily silent."]
                ],
                ["SET", "/arkham/scenarioCongressOfTheKeysVote{{$VAR}}", ["TO_INT", ["DIVIDE", "$VALUE", 10]]]
            ]
        },
        "CONGRESS_OF_THE_KEYS_VOTE": {
            "args": ["$QUESTION", "$NAME", "$VAR", "$RESULTS"],
            "code": [
                ["VALIDATE_GT0", "$QUESTION", "CONGRESS_OF_THE_KEYS_VOTE.QUESTION"],
                ["VALIDATE_NOT_EMPTY", "$NAME", "CONGRESS_OF_THE_KEYS_VOTE.NAME"],
                ["VALIDATE_NOT_EMPTY", "$VAR", "CONGRESS_OF_THE_KEYS_VOTE.VAR"],
                ["VALIDATE_NOT_NULL", "$RESULTS", "CONGRESS_OF_THE_KEYS_VOTE.RESULTS"],
                ["VAR", "$ANSWER", "$GAME.arkham.scenarioAnswer{{$QUESTION}}"],
                ["VAR", "$VALUE", ["MAP_GET", "$RESULTS", "$ANSWER", 0]],
                ["CONGRESS_OF_THE_KEYS_VOTE_RESULT", "$NAME", "$VAR", "$VALUE"]
            ]
        },
        "CONGRESS_OF_THE_KEYS_BEARER": {
            "args": ["$BEARER_NAME", "$KEY_NAME", "$VAR", "$VALUE"],
            "code": [
                ["VALIDATE_NOT_EMPTY", "$BEARER_NAME", "CONGRESS_OF_THE_KEYS_BEARER.BEARER_NAME"],
                ["VALIDATE_NOT_EMPTY", "$KEY_NAME", "CONGRESS_OF_THE_KEYS_BEARER.KEY_NAME"],
                ["VALIDATE_NOT_EMPTY", "$VAR", "CONGRESS_OF_THE_KEYS_BEARER.VAR"],
                ["VALIDATE_NOT_EMPTY", "$VALUE", "CONGRESS_OF_THE_KEYS_BEARER.VALUE"],
                ["LOG", "└── {{$BEARER_NAME}} is the bearer of {{$KEY_NAME}}."],
                ["SET", "/arkham/scenarioCongressOfTheKeysBearer{{$VAR}}", "$VALUE"]
            ]
        },
        "CONGRESS_OF_THE_KEYS_COUNT": {
            "args": ["$VALUE"],
            "code": [
                ["VALIDATE_GE0", "$VALUE", "CONGRESS_OF_THE_KEYS_COUNT.VALUE"],
                ["VAR", "$COUNT", 0],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteClaretKnight", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteBeastInACowlOfCrimson", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteEceSahin", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteAmaranth", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteRazinFarhi", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteThorne", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteAliki", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteDesiderio", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteAbarran", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteRedGlovedMan", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteLaChicaRoja", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteTheSanguineWatcher", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteTzuSanNiang", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                ["COND", ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVoteTuwileMasai", "$VALUE"], ["INCREASE_VAR", "$COUNT", 1]],
                "$COUNT"
            ]
        },
        "CONGRESS_OF_THE_KEYS_OTHERWORLD": {
            "args": ["$TARGET_GROUP_ID"],
            "code": [
                ["VAR", "$TARGET_GROUP", ["GET_GROUP_AND_VALIDATE", "$TARGET_GROUP_ID", "CONGRESS_OF_THE_KEYS_OTHERWORLD.TARGET_GROUP_ID"]],
                ["VAR", "$OTHERWORLD", ["LIST", "09747a", "09747b", "09747c", "09748a", "09748b", "09749a", "09749b", "09750", "09750"]], //Rambling Route, Rambling Route, Rambling Route, Alien Frontier, Alien Frontier, Weald of Effigies, Weald of Effigies, Cliffs of Insanity, Cliffs of Insanity
                ["FOR_EACH_START_STOP_STEP", "$I", 0, 9, 1, [
                    ["DO_CREATE_CARDS_SCN", "City of Remnants", "$OTHERWORLD.[$I]", 1, "$TARGET_GROUP_ID"]
                ]]
            ]
        },
        "CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE": {
            "args": ["$LIST", "$VAR", "$VALUE", "$DATABASE_ID"],
            "code": [
                ["VALIDATE_NOT_NULL", "$LIST", "CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE.LIST"],
                ["VALIDATE_NOT_EMPTY", "$VAR", "CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE.VAR"],
                ["VALIDATE_NOT_NULL", "$VALUE", "CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE.VALUE"],
                ["VALIDATE_NOT_EMPTY", "$DATABASE_ID", "CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE.DATABASE_ID"],
                ["COND",
                    ["AND",
                        ["GREATER_THAN", "$VALUE", 0],
                        ["EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVote{{$VAR}}", "$VALUE"]
                    ],
                    ["APPEND", "$LIST", "$DATABASE_ID"],
                    ["AND",
                        ["LESS_THAN", "$VALUE", 0],
                        ["NOT_EQUAL", "$GAME.arkham.scenarioCongressOfTheKeysVote{{$VAR}}", ["MULTIPLY", "$VALUE", -1]]
                    ],
                    ["APPEND", "$LIST", "$DATABASE_ID"],
                    ["TRUE"],
                    "$LIST"
                ]
            ]
        },
        "CONGRESS_OF_THE_KEYS_LIST_VOTING_ENEMIES": {
            "args": ["$VALUE", "$INCLUDE_RED_GLOVED_MAN"],
            "code": [
                ["VALIDATE_NOT_NULL", "$VALUE", "CONGRESS_OF_THE_KEYS_LIST_VOTING_ENEMIES.VALUE"],
                ["VAR", "$LIST", ["LIST"]],
                ["COND",
                    ["EQUAL", "$INCLUDE_RED_GLOVED_MAN", null],
                    ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "RedGlovedMan", "$VALUE", "09752"]], //The Red-Gloved Man: Purpose Unknown
                    ["EQUAL", "$INCLUDE_RED_GLOVED_MAN", true],
                    ["UPDATE_VAR", "$LIST", ["APPEND", "$LIST", "09752"]] //The Red-Gloved Man: Purpose Unknown
                ],
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "LaChicaRoja", "$VALUE", "09753"]], //La Chica Roja: Hot on Your Tail
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "TheSanguineWatcher", "$VALUE", "09754"]], //The Sanguine Watcher: He Sees What Is Not There
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "BeastInACowlOfCrimson", "$VALUE", "09755"]], //The Beast in a Cowl of Crimson: Leaving a Trail of Destruction
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "ClaretKnight", "$VALUE", "09756"]], //The Claret Knight: Holds You in Contempt
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "Thorne", "$VALUE", "09757"]], //Thorne: Open to Negotiation
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "Desiderio", "$VALUE", "09758"]], //Desiderio Delgado Álvarez: Red in His Ledger
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "Amaranth", "$VALUE", "09759"]], //Amaranth: Scarlet Scorn
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "TzuSanNiang", "$VALUE", "09760"]], //Tzu San Niang: A Whisper in Your Ear
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "Aliki", "$VALUE", "09761"]], //Aliki Zoni Uperetria: Speaks in Death
                "$LIST"
            ]
        },
        "CONGRESS_OF_THE_KEYS_LIST_VOTING_CONSPIRATORS": {
            "args": ["$VALUE", "$INCLUDE_RED_GLOVED_MAN"],
            "code": [
                ["VALIDATE_NOT_NULL", "$VALUE", "CONGRESS_OF_THE_KEYS_LIST_VOTING_CONSPIRATORS.VALUE"],
                ["VAR", "$LIST", ["LIST"]],
                ["COND",
                    ["EQUAL", "$INCLUDE_RED_GLOVED_MAN", null],
                    ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "RedGlovedMan", "$VALUE", "09692"]], //The Red-Gloved Man: He Was Always There
                    ["EQUAL", "$INCLUDE_RED_GLOVED_MAN", true],
                    ["UPDATE_VAR", "$LIST", ["APPEND", "$LIST", "09692"]] //The Red-Gloved Man: He Was Always There
                ],
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "LaChicaRoja", "$VALUE", "09557"]], //La Chica Roja: Your Watchful Shadow (side B)
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "EceSahin", "$VALUE", "09584"]], //Ece Şahin: The Vermillion-Veiled Lady
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "Desiderio", "$VALUE", "09607a"]], //Desiderio Delgado Álvarez: In Your Debt, Despite it All (side B)
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "Thorne", "$VALUE", "09625a"]], //Thorne: Consummate Professional (side B)
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "ClaretKnight", "$VALUE", "09654a"]], //The Claret Knight: Her Sworn Champion (side B)
                ["UPDATE_VAR", "$LIST", ["CONGRESS_OF_THE_KEYS_APPEND_IF_VOTE", "$LIST", "Aliki", "$VALUE", "09693"]], //Aliki Zoni Uperetria: The Maid with the Scarlet Sash
                "$LIST"
            ]
        },
        "CONGRESS_OF_THE_KEYS_SPAWN_RED_GLOVED_MAN": {
            "args": [],
            "code": [
                ["DO_CREATE_CARDS_SCN", "The Red-Gloved Man: Purpose Unknown", "09752", 1, "sharedNotInPlay"],
                ["VAR", "$MAN", "{{$GAME.lastLoadedCardIds.[0]}}"],
                ["SET", "/cardById/$MAN/sides/A/concealed", -1],
                ["SCARLET_KEYS_CONCEAL", "$GAME.firstPlayer", "$MAN", true, null]
            ]
        },
        "CONGRESS_OF_THE_KEYS_CONSPIRATOR_B": {
            "args": ["$DATABASE_ID"],
            "code": [
                ["VALIDATE_NOT_EMPTY", "$DATABASE_ID", "CONGRESS_OF_THE_KEYS_CONSPIRATOR_B.DATABASE_ID"],
                ["COND",
                    ["OR",
                        ["EQUAL", "$DATABASE_ID", "09557"],  //La Chica Roja: Your Watchful Shadow (side B)
                        ["EQUAL", "$DATABASE_ID", "09607a"], //Desiderio Delgado Álvarez: In Your Debt, Despite it All (side B)
                        ["EQUAL", "$DATABASE_ID", "09625a"], //Thorne: Consummate Professional (side B)
                        ["EQUAL", "$DATABASE_ID", "09654a"]  //The Claret Knight: Her Sworn Champion (side B)
                    ],
                    true,
                    ["TRUE"],
                    false
                ]
            ]
        },
        "CONGRESS_OF_THE_KEYS_SPAWN_CONSPIRATORS": {
            "args": ["$CONSPIRATORS"],
            "code": [
                ["VALIDATE_NOT_NULL", "$CONSPIRATORS", "CONGRESS_OF_THE_KEYS_SPAWN_CONSPIRATORS.CONSPIRATORS"],
                ["VAR", "$I", 0],
                ["FOR_EACH_VAL", "$DATABASE_ID", "$CONSPIRATORS", [
                    ["DO_CREATE_AT_SCN", null, "$DATABASE_ID", ["SUBTRACT", 97, ["MULTIPLY", 5, "$I"]], 3, ["CONGRESS_OF_THE_KEYS_CONSPIRATOR_B", "$DATABASE_ID"]],
                    ["INCREASE_VAR", "$I", 1]
                ]]
            ]
        }
    }
}
// kate: syntax Dragnlang; scheme Arkham Dark;