                        ]
                    ]],
                    ["COND",
                        ["GREATER_THAN", "$GAME.arkham.numPlayers", 1],
                        ["UPDATE_VAR", "$FINAL_MESSAGE", "{{$FINAL_MESSAGE}} In player order, each investigator (other than lead investigator) must finish spawning the Coterie enemy in their Hand."]
